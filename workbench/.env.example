# Gemini. GOOGLE_API_KEY takes precedence when both variables are set.
GOOGLE_API_KEY=
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ElevenLabs Speech-to-Text and Text-to-Speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Enterprise-only on eligible ElevenLabs accounts. Leave false otherwise.
ELEVENLABS_ZERO_RETENTION=false

# Request safety limits.
API_TIMEOUT_MS=45000
MAX_AUDIO_BYTES=12582912
